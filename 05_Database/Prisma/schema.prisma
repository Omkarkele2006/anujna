datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationStatus {
  UNREAD
  READ
}

enum RecordType {
  LAB_REPORT
  PRESCRIPTION
  DIAGNOSTIC_REPORT
  DISCHARGE_SUMMARY
  VACCINATION_RECORD
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum ConsentScope {
  ALL
  CATEGORY
  INDIVIDUAL
}

enum ConsentStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum NotificationType {
  ACCESS_REQUEST
  CONSENT_GRANTED
  CONSENT_REVOKED
  EMERGENCY_ACCESS
  VERIFICATION_STATUS
}

enum AuditActionType {
  LOGIN
  LOGOUT
  RECORD_VIEW
  CONSENT_GRANTED
  CONSENT_REVOKED
  EMERGENCY_ACCESS
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
}

// User accounts represent all registered platform participants.
model User {
  userId        String        @id @default(dbgenerated("gen_random_uuid()")) @map("user_id") @db.Uuid
  fullName      String        @map("full_name") @db.VarChar(255)
  email         String        @unique @db.VarChar(255)
  passwordHash  String        @map("password_hash") @db.VarChar(255)
  accountStatus AccountStatus @default(ACTIVE) @map("account_status")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  userRoles             UserRole[]
  patientProfile        PatientProfile?
  doctorProfile         DoctorProfile?
  uploadedRecords       HealthRecord[]              @relation("UploadedBy")
  reviewedVerifications DoctorVerificationRequest[] @relation("ReviewedBy")
  emergencyAccessEvents EmergencyAccessEvent[]
  auditLogs             AuditLog[]
  notifications         Notification[]

  @@map("users")
}

model Role {
  roleId      String   @id @default(dbgenerated("gen_random_uuid()")) @map("role_id") @db.Uuid
  roleName    String   @unique @map("role_name") @db.VarChar(50)
  description String   @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  userRoles UserRole[]

  @@map("roles")
}

// UserRole resolves User to Role many-to-many relationship.
model UserRole {
  userRoleId String   @id @default(dbgenerated("gen_random_uuid()")) @map("user_role_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [roleId], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model PatientProfile {
  patientProfileId String   @id @default(dbgenerated("gen_random_uuid()")) @map("patient_profile_id") @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  dateOfBirth      DateTime @map("date_of_birth") @db.Date
  gender           String   @db.VarChar(50)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user            User                  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  healthIdentity  HealthIdentity?
  records         HealthRecord[]
  accessRequests  AccessRequest[]
  emergencyEvents EmergencyAccessEvent[]

  @@map("patient_profiles")
}

// A doctor can request access only after verification.
model DoctorProfile {
  doctorProfileId    String   @id @default(dbgenerated("gen_random_uuid()")) @map("doctor_profile_id") @db.Uuid
  userId             String   @unique @map("user_id") @db.Uuid
  registrationNumber String   @unique @map("registration_number") @db.VarChar(100)
  isVerified         Boolean  @default(false) @map("is_verified")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                 User                        @relation(fields: [userId], references: [userId], onDelete: Cascade)
  verificationRequests DoctorVerificationRequest[]
  accessRequests       AccessRequest[]

  @@index([isVerified])
  @@map("doctor_profiles")
}

// HealthIdentity separates identifier metadata from demographics for privacy.
model HealthIdentity {
  healthIdentityId     String   @id @default(dbgenerated("gen_random_uuid()")) @map("health_identity_id") @db.Uuid
  patientProfileId     String   @unique @map("patient_profile_id") @db.Uuid
  healthIdentityNumber String   @unique @map("health_identity_number") @db.VarChar(100)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [patientProfileId], onDelete: Cascade)

  @@map("health_identities")
}

// HealthRecord metadata and secure storage references.
model HealthRecord {
  healthRecordId   String     @id @default(dbgenerated("gen_random_uuid()")) @map("health_record_id") @db.Uuid
  patientProfileId String     @map("patient_profile_id") @db.Uuid
  uploadedByUserId String     @map("uploaded_by_user_id") @db.Uuid
  recordType       RecordType @map("record_type")
  title            String     @db.VarChar(255)
  fileReference    String     @map("file_reference") @db.VarChar(512)
  uploadedAt       DateTime   @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?  @map("deleted_at") @db.Timestamptz(6)

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [patientProfileId], onDelete: Cascade)
  uploadedByUser User           @relation("UploadedBy", fields: [uploadedByUserId], references: [userId], onDelete: Restrict)

  consentRecords         ConsentHealthRecord[]
  emergencyAccessRecords EmergencyAccessRecord[]

  @@index([patientProfileId])
  @@index([recordType])
  @@index([uploadedAt])
  @@map("health_records")
}

model AccessRequest {
  accessRequestId    String        @id @default(dbgenerated("gen_random_uuid()")) @map("access_request_id") @db.Uuid
  doctorProfileId    String        @map("doctor_profile_id") @db.Uuid
  patientProfileId   String        @map("patient_profile_id") @db.Uuid
  purpose            String        @db.VarChar(500)
  requestedScopeType ConsentScope  @default(ALL) @map("requested_scope_type")
  requestedCategory  RecordType?   @map("requested_category")
  requestStatus      RequestStatus @default(PENDING) @map("request_status")
  requestedAt        DateTime      @default(now()) @map("requested_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  doctorProfile  DoctorProfile  @relation(fields: [doctorProfileId], references: [doctorProfileId], onDelete: Cascade)
  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [patientProfileId], onDelete: Cascade)
  consent        Consent?

  @@index([doctorProfileId])
  @@index([patientProfileId])
  @@index([requestStatus])
  @@map("access_requests")
}

// Consent expires automatically after endDate.
model Consent {
  consentId       String        @id @default(dbgenerated("gen_random_uuid()")) @map("consent_id") @db.Uuid
  accessRequestId String        @unique @map("access_request_id") @db.Uuid
  scopeType       ConsentScope  @default(ALL) @map("scope_type")
  recordType      RecordType?   @map("record_type")
  status          ConsentStatus @default(ACTIVE) @map("status")
  startDate       DateTime      @map("start_date") @db.Timestamptz(6)
  endDate         DateTime      @map("end_date") @db.Timestamptz(6)
  grantedAt       DateTime      @default(now()) @map("granted_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(6)

  accessRequest  AccessRequest         @relation(fields: [accessRequestId], references: [accessRequestId], onDelete: Cascade)
  consentRecords ConsentHealthRecord[]

  @@index([status, endDate])
  @@map("consents")
}

// ConsentHealthRecord maps specific documents for individual scope consent.
model ConsentHealthRecord {
  consentHealthRecordId String   @id @default(dbgenerated("gen_random_uuid()")) @map("consent_health_record_id") @db.Uuid
  consentId             String   @map("consent_id") @db.Uuid
  healthRecordId        String   @map("health_record_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  consent      Consent      @relation(fields: [consentId], references: [consentId], onDelete: Cascade)
  healthRecord HealthRecord @relation(fields: [healthRecordId], references: [healthRecordId], onDelete: Cascade)

  @@unique([consentId, healthRecordId])
  @@map("consent_health_records")
}

model DoctorVerificationRequest {
  verificationRequestId String             @id @default(dbgenerated("gen_random_uuid()")) @map("verification_request_id") @db.Uuid
  doctorProfileId       String             @map("doctor_profile_id") @db.Uuid
  reviewedByUserId      String?            @map("reviewed_by_user_id") @db.Uuid
  status                VerificationStatus @default(PENDING) @map("status")
  submittedAt           DateTime           @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedAt            DateTime?          @map("reviewed_at") @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  doctorProfile  DoctorProfile @relation(fields: [doctorProfileId], references: [doctorProfileId], onDelete: Cascade)
  reviewedByUser User?         @relation("ReviewedBy", fields: [reviewedByUserId], references: [userId], onDelete: SetNull)

  @@map("doctor_verification_requests")
}

// EmergencyAccessEvent logs access overrides without prior patient consent.
model EmergencyAccessEvent {
  emergencyAccessEventId String   @id @default(dbgenerated("gen_random_uuid()")) @map("emergency_access_event_id") @db.Uuid
  providerUserId         String   @map("provider_user_id") @db.Uuid
  patientProfileId       String   @map("patient_profile_id") @db.Uuid
  justification          String   @db.Text
  accessedAt             DateTime @default(now()) @map("accessed_at") @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  providerUser   User           @relation(fields: [providerUserId], references: [userId], onDelete: Restrict)
  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [patientProfileId], onDelete: Cascade)

  emergencyAccessRecords EmergencyAccessRecord[]

  @@map("emergency_access_events")
}

model EmergencyAccessRecord {
  emergencyAccessRecordId String   @id @default(dbgenerated("gen_random_uuid()")) @map("emergency_access_record_id") @db.Uuid
  emergencyAccessEventId  String   @map("emergency_access_event_id") @db.Uuid
  healthRecordId          String   @map("health_record_id") @db.Uuid
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  emergencyAccessEvent EmergencyAccessEvent @relation(fields: [emergencyAccessEventId], references: [emergencyAccessEventId], onDelete: Cascade)
  healthRecord         HealthRecord         @relation(fields: [healthRecordId], references: [healthRecordId], onDelete: Cascade)

  @@unique([emergencyAccessEventId, healthRecordId])
  @@map("emergency_access_records")
}

// Audit logs are immutable and never updated.
model AuditLog {
  auditLogId String          @id @default(dbgenerated("gen_random_uuid()")) @map("audit_log_id") @db.Uuid
  userId     String?         @map("user_id") @db.Uuid
  actionType AuditActionType @map("action_type")
  entityType String          @map("entity_type") @db.VarChar(100)
  entityId   String?         @map("entity_id") @db.Uuid
  ipAddress  String?         @map("ip_address") @db.VarChar(45)
  userAgent  String?         @map("user_agent") @db.VarChar(512)
  metadata   Json?           @map("metadata")
  timestamp  DateTime        @default(now()) @map("timestamp") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [userId], onDelete: SetNull)

  @@index([userId])
  @@index([timestamp])
  @@map("audit_logs")
}

model Notification {
  notificationId   String             @id @default(dbgenerated("gen_random_uuid()")) @map("notification_id") @db.Uuid
  userId           String             @map("user_id") @db.Uuid
  notificationType NotificationType   @map("notification_type")
  message          String             @db.VarChar(500)
  status           NotificationStatus @default(UNREAD) @map("status")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?          @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, status])
  @@map("notifications")
}
